# Copy to .env and adjust for your lab. Loopback is ALWAYS allowed; these
# only add to the allowlist. Keep this scoped to systems you are authorized
# to test.

# Exact hostnames to authorize (comma-separated), e.g. your DuckDNS subdomain.
RECON_ALLOWED_HOSTS=mylab.duckdns.org

# IPs / CIDRs to authorize (comma-separated), e.g. your Docker lab subnet.
RECON_ALLOWED_NETWORKS=172.28.0.0/16
